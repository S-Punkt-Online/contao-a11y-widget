{
  "name": "s-punkt-online/contao-a11y-widget",
  "description": "Ein barrierearmes Accessibility Widget als Frontend-Modul für Contao.",
  "keywords": ["contao", "accessibility", "a11y", "barrierefreiheit", "widget"],
  "type": "contao-bundle",
  "license": "MIT",
  "homepage": "https://github.com/S-Punkt-Online/contao-a11y-widget",
  "authors": [
    {
      "name": "Rashid Bairamov"
    }
  ],
  "require": {
    "php": "^8.1",
    "contao/core-bundle": "^5.3",
    "symfony/config": "^6.4 || ^7.0",
    "symfony/dependency-injection": "^6.4 || ^7.0",
    "symfony/http-foundation": "^6.4 || ^7.0",
    "symfony/http-kernel": "^6.4 || ^7.0",
    "symfony/translation-contracts": "^3.0"
  },
  "require-dev": {
    "contao/manager-plugin": "^2.13"
  },
  "conflict": {
    "contao/manager-plugin": "<2.13 || >=3.0"
  },
  "autoload": {
    "psr-4": {
      "Weba11y\\ContaoA11yWidget\\": "src/"
    }
  },
  "extra": {
    "contao-manager-plugin": "Weba11y\\ContaoA11yWidget\\ContaoManager\\Plugin"
  },
  "support": {
    "issues": "https://github.com/S-Punkt-Online/contao-a11y-widget/issues",
    "source": "https://github.com/S-Punkt-Online/contao-a11y-widget"
  }
}
