<?php $this->extend('block_unsearchable'); ?>

<?php $this->block('content'); ?>

<div class="a11y-widget" data-a11y-widget>

  <button
    type="button"
    id="<?= $this->widgetId ?>-fab"
    data-a11y-fab
    aria-label="<?= $this->fabLabel ?>"
    aria-haspopup="dialog"
    aria-controls="<?= $this->widgetId ?>-panel"
    aria-expanded="false">
    <i aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" height="24" viewBox="0 -960 960 960" width="24" fill="currentColor" focusable="false">
        <path d="M423.5-743.5Q400-767 400-800t23.5-56.5Q447-880 480-880t56.5 23.5Q560-833 560-800t-23.5 56.5Q513-720 480-720t-56.5-23.5ZM360-80v-520H120v-80h720v80H600v520h-80v-240h-80v240h-80Z"/>
      </svg>
    </i>
  </button>

  <dialog
    id="<?= $this->widgetId ?>-panel"
    data-a11y-panel
    aria-labelledby="<?= $this->widgetId ?>-title">

    <div class="a11y-panel__inner">
      <div class="a11y-panel__header">
        <h2 class="a11y-panel__title" id="<?= $this->widgetId ?>-title"><?= $this->a11yTitle ?></h2>

        <button type="button" data-a11y-close class="a11y-btn" aria-label="<?= $this->closeLabel ?>">
          <span aria-hidden="true">✕</span>
        </button>
      </div>

      <div class="a11y-panel__content">

        <?php if ($this->enableFontSize): ?>
          <div class="a11y-section">
            <h3 id="<?= $this->widgetId ?>-font-title"><?= $this->fontTitle ?></h3>

            <div class="a11y-btn-group" role="group" aria-labelledby="<?= $this->widgetId ?>-font-title">
              <button type="button" data-a11y-font-dec class="a11y-btn" aria-label="<?= $this->fontDecreaseLabel ?>">A−</button>
              <button type="button" data-a11y-font-reset class="a11y-btn" aria-label="<?= $this->fontResetLabel ?>">100%</button>
              <button type="button" data-a11y-font-inc class="a11y-btn" aria-label="<?= $this->fontIncreaseLabel ?>">A+</button>
            </div>

            <p class="a11y-sr-only" data-a11y-status aria-live="polite" data-a11y-status-prefix="<?= $this->fontTitle ?>"></p>
          </div>
        <?php endif; ?>

        <?php if ($this->enableReader): ?>
          <div class="a11y-section">
            <h3><?= $this->readerTitle ?></h3>

            <label class="a11y-toggle">
              <input data-a11y-reader type="checkbox" role="switch">
              <span><?= $this->readerText ?></span>
            </label>
          </div>
        <?php endif; ?>

        <?php if ($this->enableLinks): ?>
          <div class="a11y-section">
            <h3><?= $this->linksTitle ?></h3>

            <label class="a11y-toggle">
              <input data-a11y-links type="checkbox" role="switch">
              <span><?= $this->linksText ?></span>
            </label>
          </div>
        <?php endif; ?>

        <?php if ($this->enableSans): ?>
          <div class="a11y-section">
            <h3><?= $this->sansTitle ?></h3>

            <label class="a11y-toggle">
              <input data-a11y-sans type="checkbox" role="switch">
              <span><?= $this->sansText ?></span>
            </label>
          </div>
        <?php endif; ?>

      </div>
    </div>
  </dialog>
</div>

<?php $this->endblock(); ?>
