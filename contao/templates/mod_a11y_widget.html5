<?php $this->extend('block_unsearchable'); ?>

<?php $this->block('content'); ?>

<div class="a11y-widget" data-a11y-widget>

  <span
    id="<?= $this->widgetId ?>-fab"
    data-a11y-fab
    role="button"
    tabindex="0"
    aria-label="<?= $this->fabLabel ?>"
    aria-controls="<?= $this->widgetId ?>-panel"
    aria-expanded="false">
    <i aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" height="24" viewBox="0 -960 960 960" width="24" fill="currentColor">
        <path d="M423.5-743.5Q400-767 400-800t23.5-56.5Q447-880 480-880t56.5 23.5Q560-833 560-800t-23.5 56.5Q513-720 480-720t-56.5-23.5ZM360-80v-520H120v-80h720v80H600v520h-80v-240h-80v240h-80Z"/>
      </svg>
    </i>
  </span>

  <div
    id="<?= $this->widgetId ?>-backdrop"
    data-a11y-backdrop
    aria-hidden="true"></div>

  <aside
    id="<?= $this->widgetId ?>-panel"
    data-a11y-panel
    role="dialog"
    aria-modal="false"
    aria-labelledby="<?= $this->widgetId ?>-title"
    aria-hidden="true">

    <div class="a11y-panel__header">
      <div class="a11y-panel__title" id="<?= $this->widgetId ?>-title">
        <?= $this->a11yTitle ?>
      </div>

      <span
        data-a11y-close
        class="a11y-btn"
        role="button"
        tabindex="0"
        aria-label="<?= $this->closeLabel ?>">✕</span>
    </div>

    <div class="a11y-panel__content">

      <?php if ($this->enableFontSize): ?>
        <div class="a11y-section">
          <h3><?= $this->fontTitle ?></h3>

          <div class="a11y-btn-group" role="group" aria-label="<?= $this->fontTitle ?>">
            <span data-a11y-font-dec class="a11y-btn" role="button" tabindex="0" aria-label="<?= $this->fontDecreaseLabel ?>">A−</span>
            <span data-a11y-font-reset class="a11y-btn" role="button" tabindex="0" aria-label="<?= $this->fontResetLabel ?>">100%</span>
            <span data-a11y-font-inc class="a11y-btn" role="button" tabindex="0" aria-label="<?= $this->fontIncreaseLabel ?>">A+</span>
          </div>
        </div>
      <?php endif; ?>

      <?php if ($this->enableReader): ?>
        <div class="a11y-section">
          <h3><?= $this->readerTitle ?></h3>

          <label class="a11y-toggle">
            <input data-a11y-reader type="checkbox" role="switch" aria-label="<?= $this->readerTitle ?>">
            <span><?= $this->readerText ?></span>
          </label>
        </div>
      <?php endif; ?>

      <?php if ($this->enableLinks): ?>
        <div class="a11y-section">
          <h3><?= $this->linksTitle ?></h3>

          <label class="a11y-toggle">
            <input data-a11y-links type="checkbox" role="switch" aria-label="<?= $this->linksTitle ?>">
            <span><?= $this->linksText ?></span>
          </label>
        </div>
      <?php endif; ?>

      <?php if ($this->enableSans): ?>
        <div class="a11y-section">
          <h3><?= $this->sansTitle ?></h3>

          <label class="a11y-toggle">
            <input data-a11y-sans type="checkbox" role="switch" aria-label="<?= $this->sansTitle ?>">
            <span><?= $this->sansText ?></span>
          </label>
        </div>
      <?php endif; ?>

    </div>
  </aside>
</div>

<?php $this->endblock(); ?>
